# LLM (elegir un proveedor con function/tool calling y probar antes del jueves)
LLM_PROVIDER=groq            # groq | openai | gemini | anthropic
LLM_API_KEY=your_api_key_here
LLM_MODEL=llama-3.3-70b-versatile
LLM_BASE_URL=                # opcional (p.ej. https://api.groq.com/openai/v1 para Groq compatible OpenAI)

# Backend
PORT=3001
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173

# Frontend
VITE_API_BASE_URL=http://localhost:3001
