# ---- Aplicación ------------------------------------------------------
APP_ENV=development            # development | staging | production
LOG_LEVEL=INFO                 # DEBUG | INFO | WARNING | ERROR
LOG_FORMAT=json                # json (producción) | text (local)

# ---- LLM (proveedor con function/tool calling) -----------------------
LLM_PROVIDER=groq            # groq | openai | gemini | anthropic
LLM_API_KEY=your_api_key_here
LLM_MODEL=openai/gpt-oss-20b
LLM_BASE_URL=                # opcional (p.ej. https://api.groq.com/openai/v1 para Groq compatible OpenAI)
LLM_TIMEOUT_SECONDS=25       # timeout por llamada al proveedor
LLM_MAX_RETRIES=1            # reintentos ante errores transitorios (429/5xx/timeout)
LLM_MAX_HISTORY_MESSAGES=12  # máximo de mensajes de historial enviados al LLM
# Nota: con Groq, llama-3.3-70b-versatile puede no estar disponible; probado openai/gpt-oss-20b (ver D-004)

# ---- Backend ---------------------------------------------------------
PORT=3001
CORS_ORIGIN=http://localhost:8501

# ---- Rate limiting (/api/chat) ---------------------------------------
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS=30          # peticiones por ventana y cliente
RATE_LIMIT_WINDOW_SECONDS=60

# ---- Petición --------------------------------------------------------
MAX_HISTORY_MESSAGES=20        # máximo de mensajes aceptados en `history`

# ---- Frontend (Streamlit) --------------------------------------------
API_BASE_URL=http://localhost:3001
API_TIMEOUT=60

# ---- Tasas: demo (sin red) o live (Frankfurter con fallback local) ----
FX_SOURCE=demo
