# syntax=docker/dockerfile:1
FROM python:3.11-slim-bookworm

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    PYTHONHASHSEED=0

WORKDIR /app

# Dependencias del backend (lockfile: versiones fijadas y reproducibles)
COPY backend/requirements.txt /app/backend/requirements.txt
RUN pip install --no-cache-dir -r /app/backend/requirements.txt \
    && addgroup --system app && adduser --system --ingroup app app

# Codigo y datos necesarios en runtime
COPY --chown=app:app backend /app/backend
COPY --chown=app:app data /app/data
COPY --chown=app:app shared /app/shared
COPY --chown=app:app scripts /app/scripts

USER app

EXPOSE 3001

HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
  CMD python -c "import urllib.request; urllib.request.urlopen('http://127.0.0.1:3001/api/health', timeout=3).read()" || exit 1

CMD ["uvicorn", "backend.src.main:app", "--host", "0.0.0.0", "--port", "3001"]
